{
  "version": "2.0",
  "description": "Expanded BridgeSpeak training dataset for urgency + intent classification. Balanced across urgency (not_urgent/urgent) and intent (emergency/medical/request/social). Designed to reduce false-urgent predictions.",
  "urgency_classes": ["not_urgent", "urgent"],
  "intent_classes": ["emergency", "medical", "request", "social"],
  "notes": [
    "Urgent is reserved for true life-threatening or immediate-danger situations only.",
    "Medical symptoms that are mild or routine are not_urgent.",
    "Requests and social phrases are almost never urgent unless combined with clear danger keywords.",
    "Each example is a short keyword phrase as a deaf/mute user would type."
  ],
